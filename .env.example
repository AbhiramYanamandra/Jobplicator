# Local development: loopback only, isolated cloud-dev.db (never the legacy file).
APP_ENV=development
AUTH_MODE=local
DATABASE_URL=sqlite:///app/data/cloud-dev.db
DATABASE_SSLMODE=prefer
PUBLIC_URL=http://127.0.0.1:8787
# Hosted settings: APP_ENV=production, AUTH_MODE=supabase, PUBLIC_URL=https://...
# DATABASE_URL=postgresql+psycopg://... (Supabase session pooler, port 5432)
# DATABASE_SSLMODE=require
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated UUIDs from Supabase Authentication > Users. Required in production.
ALLOWED_USER_IDS=
# Optional separate migration connection for a database role with DDL permissions.
# MIGRATION_DATABASE_URL=
# Board imports work by default. Generic URL import is explicitly opt-in.
ENABLE_GENERIC_URL_IMPORT=false
